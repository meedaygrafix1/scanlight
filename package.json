{
  "name": "scanlight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "plugin:build": "tsc -p figma-plugin && vite build -c figma-plugin/vite.code.config.ts && vite build -c figma-plugin/vite.ui.config.ts",
    "plugin:watch": "vite build -c figma-plugin/vite.code.config.ts && vite build -c figma-plugin/vite.ui.config.ts --watch"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "kubai-icons-react": "^0.8.0",
    "mp4-muxer": "^5.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.142.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
